{
  "name": "honoki",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare 边缘 CDN 缓存由响应头 (Cloudflare-CDN-Cache-Control / CDN-Cache-Control)
  // 及自定义域名的 Cache Rules 驱动，Wrangler 配置本身无需 cache 顶层字段。
  // 静态资源目录（托管 /images/home-bg.webp, /images/avatar.webp, favicon 等）
  "assets": {
    "directory": "./public"
  },
  // KV 缓存绑定（用于缓存 GitHub 拉取的文章）
  "kv_namespaces": [
    {
      "binding": "BLOG_CACHE",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ],
  // 运行环境变量（通过环境变量配置 UMAMI_WEBSITE_ID 即可接入 Umami 访问统计）
  "vars": {
    "DEPLOY_PLATFORM": "cloudflare"
    // "UMAMI_HOST": "https://cloud.umami.is",
    // "UMAMI_WEBSITE_ID": "<YOUR_UMAMI_WEBSITE_ID>"
  }
}