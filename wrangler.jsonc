{
  "name": "honoki",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // 启用 Cloudflare Workers Cache(Wrangler >= 4.69 支持)。
  // 启用后每个 HTTP 请求都会先查边缘缓存,是否缓存/缓存多久完全由 Worker 输出的
  // Cache-Control(及 Cloudflare-CDN-Cache-Control)决定;SSR 的 HTML/JSON/RSS 因此才真正
  // 进入边缘缓存(默认 DYNAMIC,不缓存)。失效由 ctx.cache.purge()(见 /api/posts/purge)负责,
  // 注意 zone 级 purge_cache API 不影响 Workers Cache。
  "cache": {
    "enabled": true
  },
  // 静态资源目录（托管 /images/home-bg.webp, /images/avatar.webp, favicon 等）
  "assets": {
    "directory": "./public"
  },
  // KV 缓存绑定（用于缓存 GitHub 拉取的文章）
  "kv_namespaces": [
    {
      "binding": "BLOG_CACHE",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ],
  // 运行环境变量（通过环境变量配置 UMAMI_WEBSITE_ID 即可接入 Umami 访问统计）
  "vars": {
    "DEPLOY_PLATFORM": "cloudflare"
    // "UMAMI_HOST": "https://cloud.umami.is",
    // "UMAMI_WEBSITE_ID": "<YOUR_UMAMI_WEBSITE_ID>"
  }
}