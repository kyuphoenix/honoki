# 静态资源缓存策略。
# 注意:规则是「叠加」而非覆盖语义,因此各规则路径必须互不重叠,
# 否则同一资源会命中多条规则,产生重复响应头与非法值(例如 "Access-Control-Allow-Origin: *, *")。
# 边缘 TTL 用 Cloudflare-CDN-Cache-Control 表达(优先级最高且下发前被剥离),
# 且一律使用 max-age —— s-maxage / must-revalidate / proxy-revalidate 会禁用 stale-while-revalidate。

# 媒体图片(背景图、头像、文章插图)
# 浏览器 30 天,边缘 1 年,7 天 SWR
/images/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=2592000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, stale-while-revalidate=604800

# 站点图标与 Manifest
# 浏览器 30 天,边缘 1 年,1 天 SWR
# (/favicon* 已覆盖 favicon.ico、favicon.svg、favicon-96x96.png)
/favicon*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=2592000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/apple-touch-icon.png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=2592000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/web-app-manifest-192x192.png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=2592000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/web-app-manifest-512x512.png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=2592000
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

# 样式表与脚本资源
/css/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=604800
  Cloudflare-CDN-Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/js/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cache-Control: public, max-age=604800
  Cloudflare-CDN-Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
