{
  "name": "blog",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build:css": "node scripts/build-css.mjs",
    "build:js": "node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs && node scripts/build-css.mjs",
    "build": "node scripts/build-vercel.mjs",
    "deploy": "pnpm build:client && wrangler deploy --minify",
    "gen:manifest": "node scripts/gen-manifest.mjs",
    "prepare:wrangler": "node scripts/prepare-wrangler.mjs",
    "sync:cf-secrets": "node scripts/sync-cloudflare-secrets.mjs",
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "build:netlify": "node scripts/build-netlify.mjs",
    "deploy:netlify": "node scripts/deploy-netlify.mjs",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@hono/node-server": "^2.1.3",
    "@swup/preload-plugin": "^3.2.12",
    "@types/node": "^26.6.4",
    "hono": "^4.13.9",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "swup": "^4.10.0",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/katex": "^0.16.8",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}